# ── Required ──
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgres://user:password@host:5432/certprep

# ── Optional ──
PORT=3000
MODEL=claude-sonnet-4-6          # generation model (swap to claude-opus-4-8 for higher quality)
JUDGE_MODEL=claude-sonnet-4-6    # quality-check model (defaults to MODEL)
PGSSL=false                      # set "true" if your Postgres requires SSL
RATE_GENERATE=12                 # /api/generate requests per IP per 5 min
RATE_CLAUDE=40                   # /api/claude requests per IP per 5 min
ADMIN_PASSWORD=                  # set this to enable the /admin question-bank browser; unset = admin disabled
